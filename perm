// packages/backend/src/plugins/permission/TagOwnerPolicy.ts
import {
  PermissionPolicy,
} from '@backstage/plugin-permission-node';
import {
  AuthorizeResult,
} from '@backstage/plugin-permission-common';
import {
  catalogEntityReadPermission,
  catalogEntityUpdatePermission,
  catalogEntityDeletePermission,
  catalogEntityCreatePermission,
} from '@backstage/plugin-catalog-common';
import {
  catalogConditions,
  createCatalogConditionalDecision,
} from '@backstage/plugin-catalog-backend/alpha';

const ADMIN_GROUP_REFS = (process.env.ADMIN_GROUP_REFS ?? '')
  .split(',')
  .map(s => s.trim())
  .filter(Boolean);

// Helper: does the user belong to any admin group?
function isAdmin(user: { ownershipEntityRefs?: string[] } | undefined) {
  if (!user?.ownershipEntityRefs?.length) return false;
  const groups = new Set(user.ownershipEntityRefs);
  return ADMIN_GROUP_REFS.some(ref => groups.has(ref));
}

export class TagOwnerPolicy implements PermissionPolicy {
  async handle(request, user) {
    // 0) Admins bypass everything
    if (isAdmin(user)) {
      return { result: AuthorizeResult.ALLOW };
    }

    const claims = user?.ownershipEntityRefs ?? [];

    // 1) READ: public OR owner
    if (request.permission.name === catalogEntityReadPermission.name) {
      return createCatalogConditionalDecision(
        catalogEntityReadPermission,
        {
          anyOf: [
            { rule: catalogConditions.hasTag,      params: { values: ['public'] } },
            { rule: catalogConditions.isEntityOwner, params: { claims } },
          ],
        },
      );
    }

    // 2) WRITE (update/delete): only owners
    if (
      request.permission.name === catalogEntityUpdatePermission.name ||
      request.permission.name === catalogEntityDeletePermission.name
    ) {
      return createCatalogConditionalDecision(
        request.permission,
        { rule: catalogConditions.isEntityOwner, params: { claims } },
      );
    }

    // 3) CREATE (optional): choose what you want. Here: only owners of the
    // target owner (e.g., group) can create; adjust to your needs or restrict further.
    if (request.permission.name === catalogEntityCreatePermission.name) {
      return createCatalogConditionalDecision(
        catalogEntityCreatePermission,
        { rule: catalogConditions.isEntityOwner, params: { claims } },
      );
    }

    // Fallback: deny anything not explicitly handled
    return { result: AuthorizeResult.DENY };
  }
}
